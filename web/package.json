{
  "name": "edge-admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "Edge Admin frontend (Ant Design Pro)",
  "scripts": {
    "dev": "max dev",
    "start": "max dev",
    "build": "max build",
    "preview": "max preview --port 8001",
    "lint": "npm run biome:lint && npm run tsc",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "postinstall": "max setup"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.14-2",
    "@tanstack/react-query": "^5.104.5",
    "antd": "^6.6.7",
    "antd-style": "^4.1.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.7",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@umijs/max": "^4.7.27",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
