# 端口号
VITE_PORT=5999

VITE_BASE=/

# 接口地址：后端后台入口的路由前缀（经 vite.config.ts 的代理转发到 Laravel，路径不改写）
VITE_GLOB_API_URL=/api/admin

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭（已对接 Laravel 后端，关闭）
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
