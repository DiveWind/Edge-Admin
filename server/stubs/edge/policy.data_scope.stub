<?php

namespace App\Policies;

use App\Models\{{ class }};
use App\Models\User;

/**
 * 单条记录的读写受数据权限约束，与列表的 visibleTo() 规则一致。
 */
class {{ class }}Policy
{
    public function view(User $actor, {{ class }} ${{ variable }}): bool
    {
        return ${{ variable }}->isVisibleTo($actor);
    }

    public function update(User $actor, {{ class }} ${{ variable }}): bool
    {
        return ${{ variable }}->isVisibleTo($actor);
    }

    public function delete(User $actor, {{ class }} ${{ variable }}): bool
    {
        return ${{ variable }}->isVisibleTo($actor);
    }
}
