<?php

namespace {{ controller_namespace }};

use App\Http\Controllers\Controller;
use App\Http\Resources\{{ class }}Resource;
use App\Models\{{ class }};
use App\Models\User;
use Illuminate\Container\Attributes\CurrentUser;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Http\Response;
use Illuminate\Support\Facades\Gate;
use {{ request_namespace }}\{{ class }}IndexRequest;
use {{ request_namespace }}\Store{{ class }}Request;
use {{ request_namespace }}\Update{{ class }}Request;

/**
 * 接入数据权限：列表 visibleTo()，单条读写由 Policy 判定；创建时自动填充 created_by / department_id。
 */
class {{ class }}Controller extends Controller
{
    public function index({{ class }}IndexRequest $request, #[CurrentUser] User $actor): AnonymousResourceCollection
    {
        $query = {{ class }}::query()->visibleTo($actor)->filter($request->filters());

        return {{ class }}Resource::collection($request->applySort($query)->paginate($request->perPage())->withQueryString());
    }

    public function store(Store{{ class }}Request $request): {{ class }}Resource
    {
        return new {{ class }}Resource({{ class }}::query()->create($request->validated()));
    }

    public function show({{ class }} ${{ variable }}): {{ class }}Resource
    {
        Gate::authorize('view', ${{ variable }});

        return new {{ class }}Resource(${{ variable }});
    }

    public function update(Update{{ class }}Request $request, {{ class }} ${{ variable }}): {{ class }}Resource
    {
        ${{ variable }}->update($request->validated());

        return new {{ class }}Resource(${{ variable }});
    }

    public function destroy({{ class }} ${{ variable }}): Response
    {
        Gate::authorize('delete', ${{ variable }});

        ${{ variable }}->delete();

        return response()->noContent();
    }
}
