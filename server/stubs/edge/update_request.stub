<?php

namespace {{ request_namespace }};

use Illuminate\Auth\Access\Response;
use Illuminate\Support\Facades\Gate;

/**
 * 编辑与新增的字段规则相同；记录级授权（Policy）先于字段校验执行。
 */
class Update{{ class }}Request extends Store{{ class }}Request
{
    public function authorize(): Response
    {
        return Gate::inspect('update', $this->route('{{ route_parameter }}'));
    }
}
