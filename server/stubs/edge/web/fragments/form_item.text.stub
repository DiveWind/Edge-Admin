import { ProFormTextArea } from '@ant-design/pro-components';
      <ProFormTextArea
        name="{{ field.name }}"
        label={t('{{ web.locale_prefix }}.{{ field.camel }}')}
{{#if field.max}}
        fieldProps={{ rows: 3, maxLength: {{ field.max }}, showCount: true }}
{{else}}
        fieldProps={{ rows: 3 }}
{{/if}}
{{#if field.required}}
        rules={[{ required: true }]}
{{/if}}
      />
