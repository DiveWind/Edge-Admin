{{@import { ProFormDateTimePicker } from '@ant-design/pro-components'}}
{{@import { toOffsetDateTime } from '@/utils/form'}}
      <ProFormDateTimePicker
        name="{{ field.name }}"
        label={t('{{ web.locale_prefix }}.{{ field.camel }}')}
{{#if field.required}}
        rules={[{ required: true }]}
{{/if}}
        // 以浏览器本地时间显示，提交带时区偏移的 ISO 8601（契约第 2 节）
        transform={(value: unknown) => ({
          {{ field.name }}: toOffsetDateTime(value),
        })}
      />
