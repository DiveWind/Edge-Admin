{{@import { ProFormDatePicker } from '@ant-design/pro-components'}}
      <ProFormDatePicker
        name="{{ field.name }}"
        label={t('{{ web.locale_prefix }}.{{ field.camel }}')}
{{#if field.required}}
        rules={[{ required: true }]}
{{/if}}
{{#if field.nullable}}
        transform={(value: unknown) => ({ {{ field.name }}: value ?? null })}
{{/if}}
      />
