/** {{ title_plural }}页面文案（edge:make-module 生成，字段名默认为英文，请改为中文） */
export default {
  '{{ web.locale_prefix }}.create': '新建{{ title }}',
  '{{ web.locale_prefix }}.edit': '编辑{{ title }}',
{{ fields.web.locale }}
{{#if data_scope}}
  '{{ web.locale_prefix }}.department': '部门',
  '{{ web.locale_prefix }}.creator': '创建人',
{{/if}}
  // 侧边菜单 / 菜单管理 / 角色授权树中的菜单名称（中文须与 config/permissions.php 的 name 一致；操作名称使用通用文案 permission.action.*）
  'permission.{{ permission }}': '{{ title_plural }}',
};
