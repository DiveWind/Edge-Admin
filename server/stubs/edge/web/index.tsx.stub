{{@import { PlusOutlined } from '@ant-design/icons'}}
{{@import type { ActionType, ProColumns } from '@ant-design/pro-components'}}
{{@import { PageContainer, ProTable } from '@ant-design/pro-components'}}
{{@import { useAccess } from '@umijs/max'}}
{{@import { Button, Typography } from 'antd'}}
{{@import type React from 'react'}}
{{@import { useRef, useState } from 'react'}}
{{@import { DeleteAction } from '@/components'}}
{{@import { useT } from '@/utils/i18n'}}
{{@import { tableRequest } from '@/utils/table'}}
{{@import {{ web.form_component }} from './components/{{ web.form_component }}'}}
{{@import type { {{ class }} } from './data'}}
{{@import { delete{{ class }}, query{{ class_plural }} } from './service'}}
{{#if data_scope}}
{{@import { fetchSelectOptions } from '@/services/options'}}
{{/if}}
{{ imports }}

/*
 * {{ title_plural }}：由 edge:make-module 生成（docs/generator.md）。字段名文案默认为英文，请在 locales 中改为中文；
 * 列宽 / 默认隐藏列按 docs/frontend-guide.md 的列表规范按需调整。
 */
const {{ web.component }}: React.FC = () => {
  const t = useT();
  const access = useAccess();
{{ fields.web.hook }}
  const actionRef = useRef<ActionType>(null);
  const [formOpen, setFormOpen] = useState(false);
  const [editing, setEditing] = useState<{{ class }}>();

  const reload = () => actionRef.current?.reload();

  const openForm = (record?: {{ class }}) => {
    setEditing(record);
    setFormOpen(true);
  };

  const columns: ProColumns<{{ class }}>[] = [
    {
      title: 'ID',
      dataIndex: 'id',
      search: false,
      sorter: true,
      width: 80,
    },
{{ fields.web.column }}
{{#if data_scope}}
    {
      title: t('{{ web.locale_prefix }}.department'),
      dataIndex: 'department_id',
      key: 'department_id',
      valueType: 'select',
      request: () => fetchSelectOptions('departments'),
      search: false,
      width: 120,
    },
    {
      title: t('{{ web.locale_prefix }}.creator'),
      dataIndex: 'created_by',
      key: 'created_by',
      valueType: 'select',
      request: () => fetchSelectOptions('users'),
      search: false,
      width: 120,
    },
{{/if}}
    {
      title: t('common.createdAt'),
      dataIndex: 'created_at',
      key: 'created_at',
      valueType: 'dateTime',
      width: 170,
      search: false,
      sorter: true,
    },
    {
      title: t('common.actions'),
      valueType: 'option',
      width: 120,
      render: (_, record) => [
        access.can('{{ permission }}.update') && (
          <Typography.Link key="edit" onClick={() => openForm(record)}>
            {t('common.edit')}
          </Typography.Link>
        ),
        access.can('{{ permission }}.delete') && (
          <DeleteAction
            key="delete"
            onConfirm={() => delete{{ class }}(record.id)}
            onSuccess={reload}
          />
        ),
      ],
    },
  ];

  return (
    <PageContainer>
      <ProTable<{{ class }}>
        rowKey="id"
        actionRef={actionRef}
        columns={columns}
        request={tableRequest(query{{ class_plural }})}
        // 长文本 / JSON{{#if data_scope}} / 部门 / 创建人{{/if}}列默认隐藏（列设置中可打开），保证常用列在常见宽度下完整显示
        columnsState={{
          defaultValue: {
{{ fields.web.column_state }}
{{#if data_scope}}
            department_id: { show: false },
            created_by: { show: false },
{{/if}}
          },
        }}
        toolBarRender={() => [
          access.can('{{ permission }}.create') && (
            <Button
              key="create"
              type="primary"
              icon={<PlusOutlined />}
              onClick={() => openForm()}
            >
              {t('common.create')}
            </Button>
          ),
        ]}
      />
      <{{ web.form_component }}
        open={formOpen}
        onOpenChange={setFormOpen}
        record={editing}
        onSuccess={reload}
      />
    </PageContainer>
  );
};

export default {{ web.component }};
