APP_NAME="Edge Admin"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 默认 SQLite（database/database.sqlite）
DB_CONNECTION=sqlite

# MySQL 示例
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=edge_admin
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL 示例
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=edge_admin
# DB_USERNAME=postgres
# DB_PASSWORD=

# 纯 API（Sanctum Token），无需服务端会话
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# 前端允许的跨域来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Edge Admin（见 config/edge.php）
EDGE_PER_PAGE=15
EDGE_MAX_PER_PAGE=100
# 全部 /api 接口每分钟请求上限（已登录按用户、未登录按 IP）
EDGE_API_RATE_LIMIT=120
# TLS 在反向代理终止时设为 true，强制生成 https 链接
EDGE_FORCE_HTTPS=false
# Token 有效期（分钟），默认 7 天
EDGE_TOKEN_TTL=10080
# 以下两项是系统参数 security.login_max_attempts / log.retention_days 的默认值（系统参数优先）
EDGE_LOGIN_MAX_ATTEMPTS=5
EDGE_LOG_RETENTION_DAYS=90
# 附件：磁盘、单文件上限（KB）、允许的扩展名（按真实 MIME 校验）
EDGE_UPLOAD_DISK=public
EDGE_UPLOAD_MAX_SIZE=2048
EDGE_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,zip
# 代码生成器 edge:make-module 的前端工程目录（默认 ../web）
# EDGE_GENERATOR_WEB_PATH=

# 可选：Laravel Sail（Docker，compose.yaml 含 MySQL + Redis）时改用：
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=edge_admin
# DB_USERNAME=sail
# DB_PASSWORD=password
# REDIS_HOST=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
