APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

# 认证（config/core.php 的 auth）：每分钟登录次数（同一用户名 + IP）；找回密码邮件中的重置链接指向的前端页面
# CORE_LOGIN_RATE_LIMIT=5
# CORE_FRONTEND_URL=http://localhost:5999
# CORE_RESET_PASSWORD_PATH=/#/auth/reset-password
# 邮箱验证（Fortify），默认关闭
# CORE_EMAIL_VERIFICATION=false

# 本进程加载的入口（逗号分隔，见 config/core.php）；未设置时加载全部入口，设为空则不加载任何入口
CORE_APPS=admin
# CORE_ADMIN_PREFIX=api/admin
# CORE_ADMIN_RATE_LIMIT=120
# 运维动作（立即执行、重试、立即健康检查）每个用户每分钟的上限
# CORE_ADMIN_OPS_RATE_LIMIT=10
# 上传附件每个用户每分钟的上限
# CORE_ADMIN_UPLOAD_RATE_LIMIT=30
# 发起导出每个用户每分钟的上限
# CORE_ADMIN_EXPORT_RATE_LIMIT=5
# CORE_ADMIN_PAGE_SIZE=20
# CORE_ADMIN_MAX_PAGE_SIZE=100
# CORE_ADMIN_HOME_PATH=/analytics

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 操作日志、登录日志与模块审计日志的保留天数（调度每天执行 activitylog:clean）
ACTIVITYLOG_CLEAN_AFTER_DAYS=365
# 操作日志请求体中字符串值的最大长度（字符）与请求体整体的最大字节数（设计文档 §6.6）
# CORE_OPERATION_LOG_MAX_VALUE_LENGTH=1000
# CORE_OPERATION_LOG_MAX_PAYLOAD_BYTES=65536
# 失败任务输出中字符串值的最大长度（字符）与异常调用栈的最大行数
# CORE_FAILED_JOB_MAX_VALUE_LENGTH=1000
# CORE_FAILED_JOB_MAX_TRACE_LINES=30
# 定时任务执行记录的保留天数（调度每天执行 model:prune）
# SCHEDULE_MONITOR_LOG_DAYS=30
# 健康检查（阈值见 config/core.php 的 monitor.health）：结果与心跳所在的缓存（须为各进程共享的驱动）、是否检查磁盘（依赖 df）、期望的环境
# HEALTH_CACHE_STORE=database
# CORE_HEALTH_DISK_SPACE=true
# CORE_HEALTH_ENVIRONMENT=production

# 附件（config/core.php 的 attachments，设计文档 §6.8）：存储盘（私有盘，不要用 public）、签名地址与头像地址的时间窗口（分钟）、未绑定附件的保留小时数。
# 上传的类型白名单与大小上限是后台的系统参数；PHP 的 upload_max_filesize、post_max_size 与 Web 服务器的请求体上限须不小于它
# CORE_ATTACHMENT_DISK=local
# CORE_ATTACHMENT_URL_TTL=30
# CORE_ATTACHMENT_AVATAR_URL_TTL=1440
# CORE_ATTACHMENT_ORPHAN_HOURS=24

# 消息（config/core.php 的 message，设计文档 §6.9）：已读通知的保留天数、公告每批发送的人数、公告通知的链接（前端路由，{id} 为公告 id）
# CORE_NOTIFICATION_READ_DAYS=90
# CORE_ANNOUNCEMENT_BATCH_SIZE=500
# CORE_ANNOUNCEMENT_LINK=/announcements/{id}

# 异步导出（config/core.php 的 exports，设计文档 §6.10）：保留小时数、每人同时进行的上限、每次读取的行数、
# 队列任务的超时（秒，必须小于队列连接的 retry_after 并留出余量）、完成通知的链接（前端路由，可含 {id}）
# CORE_EXPORT_TTL_HOURS=24
# CORE_EXPORT_MAX_ACTIVE=3
# CORE_EXPORT_CHUNK_SIZE=500
# CORE_EXPORT_TIMEOUT=60
# CORE_EXPORT_LINK=/exports

# 富文本中允许的图片主机（逗号分隔，config/core.php 的 html，设计文档 §9）；不设置时允许任意主机的 https 图片（可被用作跟踪图片），生产环境应设置
# CORE_HTML_MEDIA_HOSTS=cdn.example.com

# 备份（config/backup.php，设计文档 §6.10）：是否调度每日备份（同时决定是否注册健康检查 Backups；未设置时 production 开启、其他环境关闭）、备份盘（逗号分隔，生产加一个异地盘）、
# 备份名（盘上的目录名，默认 APP_NAME）、压缩包密码（生产建议设置）、健康标准、失败与不健康时通知的邮箱（不设置则不发通知）。
# 运行环境须有 mysqldump / pg_dump / sqlite3 与 PHP 的 zip 扩展
# CORE_BACKUP_SCHEDULE=false
# BACKUP_DISKS=backups
# BACKUP_NAME=
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_MAX_AGE_DAYS=1
# BACKUP_MAX_STORAGE_MB=5000
# BACKUP_NOTIFICATION_MAIL=

# 默认 SQLite（database/database.sqlite，composer setup 会创建）
DB_CONNECTION=sqlite

# MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=core
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=core
# DB_USERNAME=postgres
# DB_PASSWORD=

# 会话（后台的登录状态）：database 驱动（sessions 表，停用账号、修改密码时按用户删除会话，在线会话列表读取它）；
# 生产可用 Redis（在线会话列表随之为空，需另行记录）
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 前端与 API 在同一主域名的不同子域时设为 .example.com
SESSION_DOMAIN=null
# 会话 Cookie 固定为 HttpOnly、SameSite=lax；Secure 未设置时生产环境默认开启（线上必须使用 HTTPS）
# SESSION_SECURE_COOKIE=true

# Sanctum SPA 认证：来自这些域名（按 Referer / Origin 判断，带端口时必须写上端口）的请求使用会话 Cookie 并校验 CSRF。
# 默认包含本地开发地址（前端 Vite 在 localhost:5999，经代理同源访问后端）与 APP_URL 的域名；线上前端在其他域名时设置
# SANCTUM_STATEFUL_DOMAINS=admin.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
