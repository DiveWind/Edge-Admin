APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

# 认证（config/core.php 的 auth）：每分钟登录次数（同一用户名 + IP）；找回密码邮件中的重置链接指向的前端页面
# CORE_LOGIN_RATE_LIMIT=5
# CORE_FRONTEND_URL=http://localhost:5999
# CORE_RESET_PASSWORD_PATH=/#/auth/reset-password
# 邮箱验证（Fortify），默认关闭
# CORE_EMAIL_VERIFICATION=false

# 本进程加载的入口（逗号分隔，见 config/core.php）；未设置时加载全部入口，设为空则不加载任何入口
CORE_APPS=admin
# CORE_ADMIN_PREFIX=api/admin
# CORE_ADMIN_RATE_LIMIT=120
# CORE_ADMIN_PAGE_SIZE=20
# CORE_ADMIN_MAX_PAGE_SIZE=100
# CORE_ADMIN_HOME_PATH=/analytics

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 默认 SQLite（database/database.sqlite，composer setup 会创建）
DB_CONNECTION=sqlite

# MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=core
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=core
# DB_USERNAME=postgres
# DB_PASSWORD=

# 会话（后台的登录状态）：database 驱动（sessions 表，停用账号、修改密码时按用户删除会话）；生产可用 Redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 前端与 API 在同一主域名的不同子域时设为 .example.com
SESSION_DOMAIN=null
# 会话 Cookie 固定为 HttpOnly、SameSite=lax；Secure 未设置时生产环境默认开启（线上必须使用 HTTPS）
# SESSION_SECURE_COOKIE=true

# Sanctum SPA 认证：来自这些域名（按 Referer / Origin 判断，带端口时必须写上端口）的请求使用会话 Cookie 并校验 CSRF。
# 默认包含本地开发地址（前端 Vite 在 localhost:5999，经代理同源访问后端）与 APP_URL 的域名；线上前端在其他域名时设置
# SANCTUM_STATEFUL_DOMAINS=admin.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
