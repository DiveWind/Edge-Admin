<?php

namespace {{ namespace }};

use {{ namespacedModel }};
use {{ namespacedUserModel }};
use Illuminate\Support\Facades\DB;
use Symfony\Component\HttpKernel\Exception\UnprocessableEntityHttpException;

/**
 * TODO: 说明这个用例（{{ model }}）。
 *
 * Action 是 {{ module }} 模块唯一的写入口（设计文档 §5.4）：在事务中锁行（lockForUpdate）后复核状态再写入；
 * 授权（含“只有某种状态能做”这类 403）由 Policy 判定，并发时状态已变 → 422（UnprocessableEntityHttpException 的 message），
 * 记录已不存在 → 404。
{{#audit}}
 * 审计日志由 {{ log }} 在同一事务中写入（TODO：为这个用例加一个事件）。
{{/audit}}
 */
class {{ class }}
{
{{#audit}}
    public function __construct(private readonly {{ log }} $log) {}

{{/audit}}
    /**
     * Execute the action.
     *
     * @throws UnprocessableEntityHttpException
     */
    public function handle({{ model }} ${{ modelVariable }}, {{ userModel }} $actor): {{ model }}
    {
        return DB::transaction(function () use (${{ modelVariable }}{{#audit}}, $actor{{/audit}}): {{ model }} {
            $locked = {{ model }}::query()->lockForUpdate()->findOrFail(${{ modelVariable }}->id);
{{#audit}}
            $before = $this->log->snapshot($locked);
{{/audit}}

            // TODO: 复核状态（不满足时 throw new UnprocessableEntityHttpException(__('...'))），再修改

            $locked->save();
{{#audit}}

            $this->log->handle($actor, $locked, {{ log }}::UPDATED, $before);
{{/audit}}

            return $locked;
        });
    }
}
