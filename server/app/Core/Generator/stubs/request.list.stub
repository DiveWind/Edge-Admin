{{#model}}
 * 允许的筛选与排序字段由 {{ model }}List 中 query-builder 的白名单决定，其他参数返回 422。时间区间（`起,止`）的格式由 DateTimeRangeFilter 校验。
{{#softDeletes}}
 * filter[trashed]：`with`（含已删除）或 `only`（只看已删除），其他值 422；带它时还要 viewTrashed 的授权（{{ model }}List，403）。
{{/softDeletes}}
{{/model}}
 */
class {{ class }} extends ListRequest
{
    /**
     * Get the validation rules that apply to the request.
     *
     * @return array<string, list<string>>
     */
    public function rules(): array
    {
        return [
            ...parent::rules(),
{{#name}}
            'filter.name' => ['sometimes', 'string', 'max:255'],
{{/name}}
{{#model}}
            'filter.created_at' => ['sometimes', 'string', 'max:100'],
{{/model}}
{{#softDeletes}}
            'filter.trashed' => ['sometimes', 'string', 'in:with,only'],
{{/softDeletes}}
{{^model}}
            // 'filter.status' => ['sometimes', 'string'],
{{/model}}
        ];
    }
