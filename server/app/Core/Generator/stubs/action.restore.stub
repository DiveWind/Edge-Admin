<?php

namespace {{ namespace }};

use {{ namespacedModel }};
use {{ namespacedUserModel }};
use Illuminate\Support\Facades\DB;
use Symfony\Component\HttpKernel\Exception\UnprocessableEntityHttpException;

/**
 * 恢复已删除的{{ model }}（设计文档 §10.1）。
 *
 * 只有已删除的能恢复：{{ model }}Policy 返回 403；并发时（另一人已恢复）在事务中锁行复核 → 422（message），已被彻底删除 → 404。
{{#audit}}
 * 审计日志 `{{ permission }}.restored`（只记事件）。
{{/audit}}
 */
class {{ class }}
{
{{#audit}}
    public function __construct(private readonly {{ log }} $log) {}

{{/audit}}
    /**
     * Execute the action.
     *
     * @throws UnprocessableEntityHttpException
     */
    public function handle({{ model }} ${{ modelVariable }}, {{ userModel }} $actor): {{ model }}
    {
        return DB::transaction(function () use (${{ modelVariable }}{{#audit}}, $actor{{/audit}}): {{ model }} {
            $locked = {{ model }}::query()->withTrashed()->lockForUpdate()->findOrFail(${{ modelVariable }}->id);

            if (! $locked->trashed()) {
                throw new UnprocessableEntityHttpException(__('{{ lang }}.messages.restore_trashed_only'));
            }

            $locked->restore();
{{#audit}}

            $this->log->handle($actor, $locked, {{ log }}::RESTORED);
{{/audit}}

            return $locked;
        });
    }
}
