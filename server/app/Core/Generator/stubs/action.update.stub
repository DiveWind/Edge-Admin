<?php

namespace {{ namespace }};

{{#audit}}
use App\Core\Monitor\Actions\LogAudit;
{{/audit}}
use {{ namespacedModel }};
use {{ namespacedUserModel }};
use Illuminate\Support\Facades\DB;

/**
 * 修改{{ model }}（设计文档 §5.4）：在事务中锁行后写入（记录在请求期间被删除 → 404）。
{{#audit}}
 * 审计日志 `{{ permission }}.updated`：只记变化了的字段，没有变化时不写（Monitor 的 LogAudit）。
{{/audit}}
 */
class {{ class }}
{
{{#audit}}
    public function __construct(private readonly LogAudit $audit) {}

{{/audit}}
    /**
     * Execute the action.
     *
     * @param  array<string, mixed>  $attributes  已校验的字段（模型的 `#[Fillable]`，其余键忽略）
     */
    public function handle({{ model }} ${{ modelVariable }}, array $attributes, {{ userModel }} $actor): {{ model }}
    {
        return DB::transaction(function () use (${{ modelVariable }}, $attributes{{#audit}}, $actor{{/audit}}): {{ model }} {
            $locked = {{ model }}::query()->lockForUpdate()->findOrFail(${{ modelVariable }}->id);
{{#audit}}
            $before = $locked->auditSnapshot();
{{/audit}}

            $locked->fill(array_intersect_key($attributes, array_flip($locked->getFillable())));
            $locked->save();
{{#audit}}

            $this->audit->handle($actor, $locked, 'updated', $before);
{{/audit}}

            return $locked->refresh();
        });
    }
}
