<?php

namespace {{ namespace }};

use App\Core\System\Contracts\Exporter;
use {{ namespacedUserModel }};
use {{ namespacedModel }};
use {{ moduleNamespace }}\Queries\{{ model }}List;
use Illuminate\Database\Eloquent\{Builder, Model};

/**
 * {{ model }} 列表的导出（对外名称 `{{ identifier }}`，设计文档 §6.10）：在 {{ moduleProvider }} 中登记到 ExporterRegistry。
 *
 * 查询就是列表的 {{ model }}List：同一份筛选与排序白名单、同一个数据范围{{#softDeletes}}，含 filter[trashed] 的授权（viewTrashed）{{/softDeletes}}，
 * 导出的数据不会比列表多。显示名与表头是本模块语言包（{{ lang }}.export）中的键，生成文件时按发起人的语言翻译。
 * 时间为应用时区的 `Y-m-d H:i:s`；增加字段时在 columns()、map() 与语言包中一并加上。
 *
 * @implements Exporter<{{ model }}>
 */
class {{ class }} implements Exporter
{
    public function __construct(private readonly {{ model }}List $list) {}

    /**
     * 导出的显示名。
     */
    public function title(): string
    {
        return '{{ lang }}.export.title';
    }

    /**
     * 导出的权限码（列表菜单下的 export 按钮）。
     */
    public function permission(): string
    {
        return '{{ permission }}.export';
    }

    /**
     * 列与表头。
     *
     * @return array<string, string>
     */
    public function columns(): array
    {
        $columns = ['id'{{#name}}, 'name'{{/name}}{{#creator}}, 'creator'{{/creator}}, 'created_at'{{#softDeletes}}, 'deleted_at'{{/softDeletes}}];

        return array_combine($columns, array_map(fn (string $column): string => "{{ lang }}.export.columns.{$column}", $columns));
    }

    /**
     * 列表的查询。
     *
     * @param  array<string, mixed>  $parameters
     * @return Builder<{{ model }}>
     */
    public function query({{ userModel }} $actor, array $parameters): Builder
    {
        return $this->list->builder($actor, $parameters)->getEloquentBuilder();
    }

    /**
     * 一行。
     *
     * @return array<string, string|int|null>
     */
    public function map(Model $row): array
    {
        return [
            'id' => $row->id,
{{#name}}
            'name' => $row->name,
{{/name}}
{{#creator}}
            'creator' => $row->creator?->username,
{{/creator}}
            'created_at' => $row->created_at?->format('Y-m-d H:i:s'),
{{#softDeletes}}
            'deleted_at' => $row->deleted_at?->format('Y-m-d H:i:s'),
{{/softDeletes}}
        ];
    }
}
