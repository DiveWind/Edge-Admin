<?php

namespace {{ namespace }};

use {{ namespacedModel }};
use {{ namespacedUserModel }};
use Spatie\Activitylog\Contracts\Activity;

/**
 * {{ model }} 的审计日志（设计文档 §5.5、§6.11 的结构）：写入 activitylog，日志名 `{{ logName }}`（模块名；`operation`、`login` 是 Monitor 保留的）。
 *
 * 由本模块的其他 Action 在**同一个事务**中调用：写入失败与业务写入一起回滚，审计与数据一致。
 *
 * - subject 为记录（多态别名），causer 为操作者；event 为下面的常量之一，description 为 `{{ permission }}.<event>`
 *   （稳定的标识，由前端翻译）；properties.username 是操作者的快照，properties.request_id 由 Monitor 的 Activity 自动写入；
 * - 字段变化用 spatie 的 `attributes` / `old` 结构，字段见 snapshot()：新增记 attributes；修改只记变化了的字段（没有变化时不写）；
 *   {{#softDeletes}}彻底删除记 old（删除前的全部字段）；删除、恢复只记事件。{{/softDeletes}}{{^softDeletes}}删除只记事件。{{/softDeletes}}
 * - 大字段（富文本等）不存原文，记为 `{ sha256, length }`（见 Content 的 LogArticleActivity）。
 */
class {{ class }}
{
    /**
     * 日志名。
     */
    public const string LOG_NAME = '{{ logName }}';

    public const string CREATED = 'created';

    public const string UPDATED = 'updated';

    public const string DELETED = 'deleted';
{{#softDeletes}}

    public const string RESTORED = 'restored';

    public const string FORCE_DELETED = 'force_deleted';
{{/softDeletes}}

    /**
     * Execute the action.
     *
     * @param  array<string, mixed>|null  $before  操作前的 snapshot()：修改{{#softDeletes}}、彻底删除{{/softDeletes}}时必须提供
     */
    public function handle({{ userModel }} $actor, {{ model }} ${{ modelVariable }}, string $event, ?array $before = null): ?Activity
    {
        $properties = match ($event) {
            self::CREATED => ['attributes' => $this->snapshot(${{ modelVariable }})],
            self::UPDATED => $this->changes($before ?? [], $this->snapshot(${{ modelVariable }})),
{{#softDeletes}}
            self::FORCE_DELETED => ['old' => $before ?? []],
{{/softDeletes}}
            default => [],
        };

        if ($event === self::UPDATED && $properties === []) {
            return null;
        }

        return activity(self::LOG_NAME)
            ->performedOn(${{ modelVariable }})
            ->causedBy($actor)
            ->event($event)
            ->withProperties(['username' => $actor->username, ...$properties])
            ->log("{{ permission }}.{$event}");
    }

    /**
     * 审计的字段（已保存的值）。增加字段时在这里一并加上。
     *
     * @return array<string, mixed>
     */
    public function snapshot({{ model }} ${{ modelVariable }}): array
    {
        return [
{{#name}}
            'name' => ${{ modelVariable }}->name,
{{/name}}
{{^name}}
            'id' => ${{ modelVariable }}->id,
{{/name}}
        ];
    }

    /**
     * 变化了的字段：`{ old, attributes }`；没有变化时为空数组。
     *
     * @param  array<string, mixed>  $before
     * @param  array<string, mixed>  $after
     * @return array{old?: array<string, mixed>, attributes?: array<string, mixed>}
     */
    private function changes(array $before, array $after): array
    {
        $changed = array_keys(array_filter($after, fn (mixed $value, string $key): bool => ($before[$key] ?? null) !== $value, ARRAY_FILTER_USE_BOTH));

        if ($changed === []) {
            return [];
        }

        $keys = array_flip($changed);

        return ['old' => array_intersect_key($before, $keys), 'attributes' => array_intersect_key($after, $keys)];
    }
}
